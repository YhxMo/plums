{
  "name": "plums",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:web": "playwright test",
    "lint": "eslint .",
    "check:size": "node scripts/check-size.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify:web": "npm run build && npm run check:release && npm test && npm run format:check && npm run check:project -- --boundaries && npm run check:size && npm run lint",
    "verify:native": "npm run ipc:check && npm run native:fmt && npm run native:check && npm run native:test",
    "verify": "npm run verify:web && npm run verify:native",
    "verify:e2e": "npm run test:web",
    "native": "node scripts/tauri.mjs",
    "release:mac": "node scripts/release-mac.mjs",
    "native:test": "node scripts/cargo.mjs test --locked",
    "native:check": "node scripts/cargo.mjs clippy --locked --all-targets -- -D warnings",
    "format:check": "prettier --check src modules extensions public scripts tests *.json *.ts eslint.config.js index.html",
    "native:fmt": "node scripts/cargo.mjs fmt -- --check",
    "check:project": "node scripts/check-project.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "icons": "node scripts/icons.mjs",
    "android:init": "node scripts/android.mjs init",
    "android:prepare": "node scripts/android.mjs prepare",
    "android:build": "node scripts/android.mjs build",
    "ipc:generate": "node scripts/ipc.mjs",
    "ipc:check": "node scripts/ipc.mjs --check",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "fflate": "0.8.3",
    "lucide-react": "1.60.0",
    "motion": "14.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.7",
    "sonner": "2.0.8",
    "use-stick-to-bottom": "1.1.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
