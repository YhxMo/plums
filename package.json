{
  "name": "plums",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:web": "playwright test",
    "native": "node scripts/tauri.mjs",
    "native:test": "node scripts/cargo.mjs test --locked",
    "native:check": "node scripts/cargo.mjs clippy --locked --all-targets -- -D warnings",
    "format:check": "prettier --check src modules extensions scripts tests *.json *.ts index.html",
    "native:fmt": "node scripts/cargo.mjs fmt -- --check",
    "check:project": "node scripts/check-project.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "android:init": "node scripts/android.mjs init",
    "android:prepare": "node scripts/android.mjs prepare",
    "android:build": "node scripts/android.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
