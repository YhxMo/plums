{
  "name": "plums",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p packages/core/tsconfig.json && tsc -p packages/cli/tsconfig.json",
    "test": "pnpm run build && vitest run",
    "bench:performance": "pnpm build && node --expose-gc scripts/bench-performance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "plums": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
