{
  "name": "plums",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @plums/core build && pnpm --filter plums build && pnpm --filter @plums/sdk build && pnpm --filter @plums/host build && pnpm --filter @plums/desktop build",
    "test": "node scripts/prepare-test-runtime.mjs && pnpm run build && vitest run",
    "conformance:platform": "pnpm build && node scripts/platform-conformance.mjs",
    "bench:performance": "pnpm build && node --expose-gc scripts/bench-performance.mjs",
    "desktop:dev": "pnpm build && node scripts/run-desktop.mjs",
    "desktop:package": "pnpm build && node scripts/package-desktop.mjs",
    "test:experiments": "PLUMS_NATIVE_EXPERIMENTS=1 vitest run packages/host/test/project-members.experiments.test.ts --project experiments --maxWorkers=1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.30",
    "esbuild": "^0.25.0",
    "plums": "workspace:*",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
