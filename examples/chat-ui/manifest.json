{
  "formatVersion": "2.0",
  "kind": "extension",
  "id": "chat",
  "name": "Plum Chat",
  "version": "1.0.0",
  "description": "聊天界面、工具循环与会话保存，由外装扩展提供。",
  "dependencies": [
    {
      "kind": "connector",
      "id": "model",
      "range": "^1.0.0"
    }
  ],
  "permissions": [
    {
      "id": "workspace",
      "kind": "fs",
      "target": "workspace",
      "operations": ["read", "write", "list"],
      "reason": "使用你选定的工作目录"
    },
    {
      "id": "history",
      "kind": "fs",
      "target": "agent-data",
      "operations": ["read", "write"],
      "reason": "读取和保存此 Agent 的会话"
    },
    {
      "id": "model-access",
      "kind": "egress",
      "target": "api.openai.com",
      "reason": "通过模型连接器发送会话"
    }
  ],
  "license": "Apache-2.0",
  "payload": {
    "plumsDesktop": {
      "sdkVersion": "1",
      "runtime": "runtime/main.js",
      "frontend": "ui/index.html",
      "contributes": {
        "commands": [
          {
            "name": "chat",
            "title": "发送消息",
            "inputSchema": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          },
          {
            "name": "history",
            "title": "读取会话"
          }
        ],
        "tools": [
          {
            "name": "list_directory",
            "title": "列目录",
            "inputSchema": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          {
            "name": "read_file",
            "title": "读取文件",
            "inputSchema": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          {
            "name": "write_file",
            "title": "写入文件",
            "inputSchema": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": ["path", "text"],
              "additionalProperties": false
            }
          }
        ]
      }
    }
  }
}
