{
  "formatVersion": "2.0",
  "kind": "connector",
  "id": "model",
  "name": "模型连接器",
  "version": "2.0.0",
  "description": "配置协议、模型名称、Base URL 和 API Key，连接文本模型服务。",
  "dependencies": [],
  "permissions": [
    {
      "id": "model-api",
      "kind": "service",
      "target": "https",
      "reason": "请求配置的模型服务",
      "operations": [
        "request"
      ]
    }
  ],
  "license": "Apache-2.0",
  "payload": {
    "plumsDesktop": {
      "sdkVersion": "2",
      "runtime": "runtime/main.js",
      "contributes": {
        "connectors": [
          {
            "name": "complete",
            "title": "模型请求"
          }
        ]
      },
      "connections": [
        {
          "id": "api",
          "permissionId": "model-api",
          "baseURLSetting": "endpoint",
          "labelSetting": "model",
          "selectorSetting": "protocol",
          "credentialProfiles": {
            "OpenAI Chat Completions": [
              {
                "setting": "apiKey",
                "header": "Authorization",
                "prefix": "Bearer "
              }
            ],
            "OpenAI Responses": [
              {
                "setting": "apiKey",
                "header": "Authorization",
                "prefix": "Bearer "
              }
            ],
            "Anthropic Messages": [
              {
                "setting": "apiKey",
                "header": "x-api-key"
              }
            ],
            "Gemini": [
              {
                "setting": "apiKey",
                "header": "x-goog-api-key"
              }
            ]
          }
        }
      ]
    }
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "protocol": {
        "type": "string",
        "title": "协议",
        "description": "选择服务商提供的文本模型接口协议。",
        "enum": [
          "OpenAI Chat Completions",
          "OpenAI Responses",
          "Anthropic Messages",
          "Gemini"
        ],
        "default": "OpenAI Chat Completions"
      },
      "model": {
        "type": "string",
        "title": "模型名称",
        "description": "填写服务商提供的模型名称，无需选择预设模型。"
      },
      "endpoint": {
        "type": "string",
        "title": "Base URL",
        "description": "填写服务商提供的 HTTPS 基础地址，例如 https://api.openai.com/v1；请求路径按协议自动补全。",
        "default": "https://api.openai.com/v1"
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "填写模型服务提供的 API Key，保存后不会向扩展显示。",
        "x-secret": true
      }
    },
    "required": [
      "model",
      "apiKey"
    ]
  }
}
