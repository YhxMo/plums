{
  "formatVersion": "2.0",
  "kind": "connector",
  "id": "remote-mcp",
  "name": "远程 MCP",
  "version": "1.0.0",
  "description": "远程 Streamable HTTP MCP 发现与工具调用。",
  "dependencies": [],
  "permissions": [
    {
      "id": "mcp-api",
      "kind": "egress",
      "target": "mcp.deepwiki.com",
      "reason": "访问所配置的远程 MCP 服务"
    }
  ],
  "license": "Apache-2.0",
  "payload": {
    "plumsDesktop": {
      "sdkVersion": "1",
      "runtime": "runtime/main.js",
      "contributes": {
        "connectors": [
          {
            "name": "discover",
            "title": "连接并发现工具"
          },
          {
            "name": "call",
            "title": "调用已批准工具",
            "inputSchema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "arguments": {
                  "type": "object"
                }
              },
              "required": ["name"]
            }
          }
        ]
      }
    }
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "endpoint": {
        "type": "string",
        "title": "远程 MCP 地址",
        "description": "更换域名须先更新组件权限声明。",
        "default": "https://mcp.deepwiki.com/mcp"
      }
    }
  }
}
