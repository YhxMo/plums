{
  "formatVersion": "2.0",
  "kind": "extension",
  "id": "board",
  "name": "纸上看板",
  "version": "1.0.0",
  "description": "独立看板工作界面，数据保存在当前 Agent。",
  "dependencies": [],
  "permissions": [
    {
      "id": "board-data",
      "kind": "fs",
      "target": "agent-data",
      "operations": ["read", "write"],
      "reason": "读取和保存看板卡片"
    }
  ],
  "license": "Apache-2.0",
  "payload": {
    "plumsDesktop": {
      "sdkVersion": "1",
      "runtime": "runtime/main.js",
      "frontend": "ui/index.html",
      "contributes": {
        "commands": [
          {
            "name": "load",
            "title": "读取看板"
          },
          {
            "name": "add",
            "title": "添加卡片",
            "inputSchema": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          },
          {
            "name": "toggle",
            "title": "切换完成状态",
            "inputSchema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          }
        ]
      }
    }
  }
}
