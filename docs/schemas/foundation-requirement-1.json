{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plums.dev/schema/foundation-requirement-1.json",
  "type": "object",
  "properties": {
    "requirementVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "protocolRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sdk": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "version": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["id", "version"],
      "additionalProperties": true
    },
    "features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "optionalFeatures": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  },
  "required": ["requirementVersion", "protocolRange", "sdk", "features"],
  "additionalProperties": true
}
