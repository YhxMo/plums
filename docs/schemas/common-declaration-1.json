{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plums.dev/schema/common-declaration-1.json",
  "type": "object",
  "properties": {
    "commonVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "runtime": {
      "enum": [
        "isolate",
        "controlled-node"
      ]
    },
    "background": {
      "type": "boolean"
    },
    "resources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "permissionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write",
                "delete"
              ]
            }
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "permissionId",
          "operations"
        ],
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "provideId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "provideId"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "commonVersion",
    "features",
    "runtime"
  ],
  "additionalProperties": true
}
