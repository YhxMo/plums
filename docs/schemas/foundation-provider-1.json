{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plums.dev/schema/foundation-provider-1.json",
  "type": "object",
  "properties": {
    "declarationVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "foundationVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "execution": {
      "enum": [
        "controlled-node",
        "builtin-adapter"
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "hostFeatures": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "dataFormats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sdks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "features": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "featureRanges": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "range": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "features": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  }
                }
              },
              "required": [
                "range",
                "features"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "range",
          "features"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "declarationVersion",
    "id",
    "foundationVersion",
    "entry",
    "execution",
    "platforms",
    "features",
    "hostFeatures",
    "sdks"
  ],
  "additionalProperties": true
}
