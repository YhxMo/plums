{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plums.dev/schema/foundation-selection-1.json",
  "type": "object",
  "properties": {
    "selectionVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "source": {
      "enum": ["builtin", "library"]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": ["selectionVersion", "source", "id", "version", "digest"],
  "additionalProperties": true
}
